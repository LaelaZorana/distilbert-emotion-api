{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Emotion API \u2014 Service Overview",
  "uid": "emotion-api-overview",
  "tags": [
    "emotion-api",
    "mlops"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(emotion_api_requests_total[1m]))",
          "legendFormat": "req/s",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx %)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(emotion_api_errors_total[5m])) / clamp_min(sum(rate(emotion_api_requests_total[5m])), 1)",
          "legendFormat": "5xx %",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "In-flight requests",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "emotion_api_requests_in_progress",
          "legendFormat": "in flight",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(emotion_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency percentiles",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(emotion_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(emotion_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(emotion_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(emotion_api_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model inference latency (p50/p95/p99)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(emotion_api_inference_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(emotion_api_inference_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(emotion_api_inference_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average inference batch size",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "emotion-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(emotion_api_inference_batch_size_sum[5m]) / clamp_min(rate(emotion_api_inference_batch_size_count[5m]), 1)",
          "legendFormat": "avg batch",
          "datasource": {
            "type": "prometheus",
            "uid": "emotion-prometheus"
          }
        }
      ]
    }
  ],
  "__inputs": [],
  "__requires": []
}
